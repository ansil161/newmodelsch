# Versioned API root, e.g. https://api.example.com/api/v1
# Leave empty to call /api/v1 on the site's own origin: the dev server proxies
# it (below), and in production the host routes /api to Django.
VITE_API_BASE_URL=
VITE_APP_NAME=
VITE_ENV=development

# `npm run dev` / `npm run preview`: where the /api proxy forwards to.
# Not VITE_-prefixed, so it never reaches the browser bundle.
DEV_API_PROXY_TARGET=http://127.0.0.1:8000
