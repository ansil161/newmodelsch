# -----------------------------------------------------------------------------
# Copy to backend/.env for local development, or set these as real environment
# variables on the server. Placeholders only - never commit a filled-in copy.
# -----------------------------------------------------------------------------

# --- Core ---------------------------------------------------------------------
DEBUG=False
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# The API's own hostnames, comma-separated, e.g. api.example.com
ALLOWED_HOSTS=

# --- Database (PostgreSQL only) ----------------------------------------------
# postgres://USER:PASSWORD@HOST:5432/NAME
DATABASE_URL=

# --- Browser origins ----------------------------------------------------------
# Exact scheme://host[:port] of the frontend, comma-separated. Never a wildcard.
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
# Reverse proxies in front of Django that append to X-Forwarded-For (0 = none).
TRUSTED_PROXY_COUNT=0
# True only behind a proxy that overwrites X-Forwarded-Proto.
USE_X_FORWARDED_PROTO=False

# --- JWT ----------------------------------------------------------------------
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=10
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
# Optional separate signing key; defaults to SECRET_KEY.
JWT_SIGNING_KEY=

# --- Cookies ------------------------------------------------------------------
ACCESS_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token
COOKIE_SECURE=True
# Always True; setting False refuses to start.
COOKIE_HTTPONLY=True
# Lax | Strict | None (None requires COOKIE_SECURE=True and a cross-site frontend)
COOKIE_SAMESITE=Lax
# Blank = host-only cookies on the API host (recommended).
COOKIE_DOMAIN=

# --- Brute-force protection ---------------------------------------------------
LOGIN_THROTTLE_IP_BURST=10/min
LOGIN_THROTTLE_IP_SUSTAINED=100/hour
REFRESH_THROTTLE_IP=30/min
LOGIN_FAILURE_LIMIT=5
LOGIN_FAILURE_WINDOW_SECONDS=900
REFRESH_REUSE_GRACE_SECONDS=30

# --- Cache --------------------------------------------------------------------
# redis://host:6379/0 - shared rate-limit counters. Optional: without it,
# production uses the database cache (run `manage.py createcachetable`).
REDIS_URL=

# --- HTTPS (production) -------------------------------------------------------
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# --- Email (production SMTP) --------------------------------------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# --- Knowledge base -----------------------------------------------------------
# The AI service (ai_service/) and the shared token it expects: set this to the
# same value as its SECURITY__SERVICE_TOKEN. Never exposed to the browser.
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_TOKEN=
AI_SERVICE_TIMEOUT_SECONDS=30
KB_INGEST_TIMEOUT_SECONDS=600
KB_CHAT_TIMEOUT_SECONDS=120
# Token the AI service's re-index worker presents to /api/internal/ — the same
# value as its MAIN_BACKEND_TOKEN. Leave empty to disable those endpoints.
KB_INTERNAL_API_TOKEN=
# Private upload directory, outside any web root. Default: backend/var/knowledge_base
KB_STORAGE_ROOT=
# Keep at or below the AI service's INGESTION__MAX_FILE_BYTES.
KB_MAX_UPLOAD_BYTES=26214400
KB_ALLOWED_EXTENSIONS=pdf,docx,txt,md,csv,json
# worker: run `python manage.py process_documents` alongside the web process.
# thread: jobs run inside the web process (the development default).
KB_TASK_DISPATCH=worker
KB_JOB_MAX_ATTEMPTS=3
# Must exceed KB_INGEST_TIMEOUT_SECONDS.
KB_JOB_STALE_SECONDS=900
# none | clamav (streams uploads to clamd; fails closed when unreachable)
KB_MALWARE_SCANNER=none
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
KB_UPLOAD_THROTTLE=120/hour
KB_SOURCE_THROTTLE=60/hour
KB_RAG_TEST_THROTTLE=30/min
KB_CHAT_THROTTLE=20/min

# --- Logging ------------------------------------------------------------------
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=json
