# ---------------------------------------------------------------------------
# JAAZ AI service configuration
#
# Copy to ai_service/.env for local development. In production these come
# from the platform's secret store — do not ship a .env file to a server.
#
# PLACEHOLDERS ONLY IN THIS FILE. Never commit a real key here.
#
# Nested settings use a double underscore: QDRANT__API_KEY sets
# Settings.qdrant.api_key.
# ---------------------------------------------------------------------------

ENVIRONMENT=development          # development | testing | production
SERVICE_NAME=jaaz-ai-service
DEBUG=false

# --- Trust between the main backend and this service -----------------------
# A shared bearer token. Django sends it; this service compares it in
# constant time. REQUIRED in production — the process refuses to start
# without it, because "nobody knows the URL" is not access control.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECURITY__SERVICE_TOKEN=

# Empty unless a browser must call this service directly. It normally must
# not: the browser talks to Django, and Django talks to this.
SECURITY__CORS_ALLOW_ORIGINS=

# --- Qdrant Cloud ----------------------------------------------------------
# Host only, no key in the URL.
QDRANT__URL=https://your-cluster-id.region.aws.cloud.qdrant.io
QDRANT__API_KEY=
QDRANT__COLLECTION=jaaz_knowledge_base
# Must equal EMBEDDING__DIMENSIONS. Startup refuses to run if it does not.
QDRANT__VECTOR_SIZE=768
QDRANT__DISTANCE=Cosine
QDRANT__TIMEOUT_SECONDS=20
# Development only: an embedded, on-disk Qdrant in this directory instead of
# a server (QDRANT__URL and QDRANT__API_KEY are then ignored). Refused when
# ENVIRONMENT=production.
# QDRANT__LOCAL_PATH=./var/qdrant

# --- Embeddings ------------------------------------------------------------
# huggingface_api        hosted inference; no weights on disk, no torch.
# sentence_transformers  SentenceTransformer("BAAI/bge-base-en-v1.5") in
#                        process. Needs requirements-local-models.txt and
#                        ~1.5GB of disk. Faster, private, no rate limit.
#
# Both produce identical vectors — same model, 768 dimensions, L2
# normalised — so switching does NOT require a reindex.
EMBEDDING__PROVIDER=huggingface_api
EMBEDDING__MODEL=BAAI/bge-base-en-v1.5
EMBEDDING__DIMENSIONS=768
# A Hugging Face access token (hf_…). Read-only is sufficient.
EMBEDDING__API_KEY=
EMBEDDING__API_BASE=https://router.huggingface.co/hf-inference/models
EMBEDDING__BATCH_SIZE=32
EMBEDDING__TIMEOUT_SECONDS=60
EMBEDDING__MAX_RETRIES=3
EMBEDDING__QUERY_CACHE_SIZE=512
# Local provider only. Empty → torch picks (cuda when present).
EMBEDDING__DEVICE=
EMBEDDING__CACHE_DIR=

# --- Reranking -------------------------------------------------------------
# huggingface_api | cross_encoder | none
# "none" passes the RRF-fused ranking through unchanged. Legitimate, not
# broken — this is the most expensive stage in the pipeline.
RERANKER__PROVIDER=huggingface_api
RERANKER__MODEL=BAAI/bge-reranker-base
RERANKER__API_KEY=
RERANKER__TIMEOUT_SECONDS=30

# --- Retrieval accuracy dials ----------------------------------------------
# Tuned together, not individually. Raising DENSE_TOP_K without raising
# RERANK_TOP_K just gives the reranker more to discard.
RETRIEVAL__DENSE_TOP_K=30
RETRIEVAL__SPARSE_TOP_K=30
# Reciprocal Rank Fusion smoothing. 60 is the paper's value; lower sharpens
# the influence of top ranks.
RETRIEVAL__FUSION_K=60
# Raise SPARSE_WEIGHT for collections full of part numbers and codes; raise
# DENSE_WEIGHT for prose.
RETRIEVAL__DENSE_WEIGHT=1.0
RETRIEVAL__SPARSE_WEIGHT=1.0
RETRIEVAL__RERANK_TOP_K=20
RETRIEVAL__FINAL_CONTEXT_CHUNKS=6
RETRIEVAL__SIMILARITY_THRESHOLD=0.30
RETRIEVAL__RERANK_SCORE_THRESHOLD=0.0
RETRIEVAL__MAX_CONTEXT_CHARACTERS=12000

# --- LLM providers ---------------------------------------------------------
# gemini | groq | xai. Fallback must differ from primary; leave empty to
# disable fallback entirely.
LLM__PRIMARY=gemini
LLM__FALLBACK=groq
LLM__MAX_ATTEMPTS_PER_PROVIDER=2

# Google AI Studio key (AIza…). Header-authenticated, never in a query string.
LLM__GEMINI__API_KEY=
LLM__GEMINI__MODEL=gemini-2.0-flash
LLM__GEMINI__BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM__GEMINI__TIMEOUT_SECONDS=60
LLM__GEMINI__MAX_OUTPUT_TOKENS=1024
LLM__GEMINI__TEMPERATURE=0.2

# Groq — api.groq.com. Keys begin gsk_.
LLM__GROQ__API_KEY=
LLM__GROQ__MODEL=llama-3.3-70b-versatile
LLM__GROQ__BASE_URL=https://api.groq.com/openai/v1

# xAI (Grok) — api.x.ai. Keys begin xai-. A DIFFERENT SERVICE FROM GROQ;
# the two are constantly confused. Same wire format, so one implementation
# serves both.
LLM__XAI__API_KEY=
LLM__XAI__MODEL=grok-3-mini
LLM__XAI__BASE_URL=https://api.x.ai/v1

# --- Conversation context --------------------------------------------------
# Unbounded history is how a chat endpoint's cost grows with the square of
# the conversation length.
CONVERSATION__MAX_HISTORY_MESSAGES=8
CONVERSATION__MAX_HISTORY_MESSAGE_CHARACTERS=2000
CONVERSATION__REWRITE_CONTEXT_MESSAGES=4

# --- Query rewriting -------------------------------------------------------
# Only runs when a cheap heuristic says the question depends on prior turns.
QUERY_REWRITE__ENABLED=true
QUERY_REWRITE__MIN_WORDS_TO_SKIP_REWRITE=6
QUERY_REWRITE__TIMEOUT_SECONDS=12

# --- Assistant -------------------------------------------------------------
# How the assistant names itself and describes what it answers from, in the
# system prompt. Set both for the deployment.
ASSISTANT__NAME=the New Model High School assistant
ASSISTANT__CORPUS_DESCRIPTION=the school's knowledge base of policies, handbooks and admissions information

# --- Ingestion -------------------------------------------------------------
# Limits on everything a hostile file can grow in. Exceeding one refuses the
# document with a reason; nothing is indexed partially.
INGESTION__MAX_FILE_BYTES=26214400
INGESTION__MAX_PAGES=1500
INGESTION__MAX_EXTRACTED_CHARACTERS=4000000
INGESTION__MAX_UNCOMPRESSED_BYTES=157286400
INGESTION__MAX_COMPRESSION_RATIO=120
INGESTION__MAX_TABLE_ROWS=50000
INGESTION__MAX_CONCURRENT_EXTRACTIONS=2
# Chunking, in estimated tokens. MIN < TARGET <= MAX, OVERLAP < TARGET, and
# MAX must fit EMBEDDING__MAX_SEQUENCE_LENGTH. Changing these changes every
# chunk: reprocess the documents afterwards.
INGESTION__CHUNK_TARGET_TOKENS=300
INGESTION__CHUNK_MAX_TOKENS=420
INGESTION__CHUNK_OVERLAP_TOKENS=45
INGESTION__CHUNK_MIN_TOKENS=24
INGESTION__MAX_CHUNKS=5000
INGESTION__INCLUDE_SECTION_PATH=true

# --- URL ingestion ---------------------------------------------------------
# Every address a name resolves to must be public; each redirect is checked
# again. ALLOW_PRIVATE_NETWORKS is for tests only and refused in production.
URL_FETCH__TIMEOUT_SECONDS=20
URL_FETCH__CONNECT_TIMEOUT_SECONDS=8
URL_FETCH__MAX_BYTES=10485760
URL_FETCH__MAX_REDIRECTS=5
URL_FETCH__ALLOW_PRIVATE_NETWORKS=false

# --- Rate limiting ---------------------------------------------------------
# In-process counters: correct for one instance, an approximation for two.
RATE_LIMIT__ENABLED=true
RATE_LIMIT__CHAT_REQUESTS_PER_MINUTE=20
RATE_LIMIT__CHAT_REQUESTS_PER_HOUR=200
RATE_LIMIT__INDEX_REQUESTS_PER_MINUTE=60

# --- Observability ---------------------------------------------------------
OBSERVABILITY__LOG_LEVEL=INFO
OBSERVABILITY__LOG_FORMAT=console        # console | json (json in production)
# Reserved. Intended to log the first characters of a question at DEBUG;
# no code reads it yet, so setting it has no effect. Kept because
# question text is user content and the switch belongs here when it is
# wired up, not somewhere it can be turned on by accident.
OBSERVABILITY__LOG_QUERY_TEXT=false

# --- Worker ----------------------------------------------------------------
# Where the reindex job reads documents from.
MAIN_BACKEND_URL=http://localhost:8000
MAIN_BACKEND_TOKEN=
REINDEX_TENANT_ID=default

# --- Runtime ---------------------------------------------------------------
# Pin BLAS to one thread. numpy/torch otherwise allocate per-thread buffers
# for every core, which oversubscribes badly when several uvicorn workers
# share a box — and fails outright on a memory-constrained one.
OPENBLAS_NUM_THREADS=1
OMP_NUM_THREADS=1
